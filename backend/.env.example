# DashTiny Backend Environment Template
PROJECT_NAME="DashTiny Getaways API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=dashtiny_db
POSTGRES_PORT=5432

# Redis Cache & PubSub
REDIS_HOST=localhost
REDIS_PORT=6379

# Cryptographic JWT Secret
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_cryptographically_secure_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Planner / LLM Provider (Free Options)
# Option 1: Google Gemini Flash (100% Free at aistudio.google.com)
GEMINI_API_KEY=your_free_google_gemini_api_key_here
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash

# Option 2: Groq (100% Free at console.groq.com)
# GROQ_API_KEY=your_free_groq_api_key_here
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile

# Option 3: Local Ollama (100% Free Offline, no key needed)
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://localhost:11434/v1
